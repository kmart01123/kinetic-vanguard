  "primitives": [
    {"id":"active_turn_denial","family":"action_denial","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Actions and bonus actions are unavailable."},
    {"id":"reaction_denial","family":"reaction_denial","exposure_basis":"reaction_window","default_status":"candidate","reason":"Reactions are unavailable."},
    {"id":"offensive_impairment_next_attack","family":"offense","exposure_basis":"attack_opportunity","default_status":"candidate","reason":"Only the next attack is impaired."},
    {"id":"offensive_impairment_all_attacks","family":"offense","exposure_basis":"target_turn_window","default_status":"candidate","reason":"All attacks in the affected window are impaired."},
    {"id":"target_choice_restriction","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on the restricted source and available target choices."},
    {"id":"sight_option_denial","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on sight-dependent options and alternative senses."},
    {"id":"mobility_loss_feet","family":"mobility","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Movement capacity is reduced by an exact flat number of feet."},
    {"id":"movement_mode_denial","family":"mobility","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on the target's usable movement modes."},
    {"id":"forced_displacement","family":"displacement","exposure_basis":"instantaneous_occurrence","default_status":"candidate","reason":"Intrinsic displacement is measured only in feet; no battlefield bonus is inferred."},
    {"id":"geometry_sensitive_approach_restriction","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Requires source geometry and a willing movement choice."},
    {"id":"defensive_attack_advantage","family":"defense_enablement","exposure_basis":"incoming_attack_opportunity","default_status":"candidate","reason":"Incoming attacks have Advantage."},
    {"id":"save_disadvantage","family":"save_enablement","exposure_basis":"save_opportunity","default_status":"candidate","reason":"A specified saving throw has Disadvantage."},
    {"id":"save_auto_failure","family":"save_enablement","exposure_basis":"save_opportunity","default_status":"candidate","reason":"A specified saving throw automatically fails."},
    {"id":"ability_check_impairment","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Requires a relevant ability-check opportunity and any stated predicate."},
    {"id":"speech_denial","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Requires a communication-dependent opportunity."},
    {"id":"social_interaction_advantage","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Requires a social interaction check involving the source."},
    {"id":"concentration_break","family":"option_restriction","exposure_basis":"instantaneous_occurrence","default_status":"context_required","reason":"Requires the target to be concentrating."},
    {"id":"fall_transition","family":"displacement","exposure_basis":"instantaneous_occurrence","default_status":"context_required","reason":"Requires airborne state and lack of hover or fall prevention."},
    {"id":"prone_incoming_attack_context","family":"defense_enablement","exposure_basis":"incoming_attack_opportunity","default_status":"context_required","reason":"Incoming attack effect depends on attacker distance."},
    {"id":"melee_hit_auto_critical_context","family":"defense_enablement","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Automatic critical hits require a hit from an attacker within 5 feet."},
    {"id":"awareness_denial","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on encounter information and awareness-sensitive opportunities."},
    {"id":"opportunity_attack_denial","family":"reaction_denial","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Only a qualifying Opportunity Attack is denied; other Reactions remain available."},
    {"id":"terrain_movement_tax","family":"mobility","exposure_basis":"target_turn_window","default_status":"context_required","reason":"Movement through the affected terrain costs additional movement without changing the Speed statistic."},
    {"id":"directional_movement_tax","family":"mobility","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"The movement cost applies only in a specified direction and requires geometry."},
    {"id":"specified_action_requirement","family":"action_restriction","exposure_basis":"target_turn_window","default_status":"candidate","reason":"A specified Action is required while other turn options remain separately available."},
    {"id":"action_bonus_exclusivity","family":"action_restriction","exposure_basis":"target_turn_window","default_status":"candidate","reason":"The target may use an Action or Bonus Action, but not both."},
    {"id":"attack_action_cap","family":"action_restriction","exposure_basis":"attack_opportunity","default_status":"context_required","reason":"The target's Attack action is capped, but the maintained target catalog does not establish a baseline attack count."},
    {"id":"bonus_action_denial","family":"action_denial","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Bonus Actions are unavailable while Actions and movement remain separately governed."},
    {"id":"turn_movement_denial","family":"mobility","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Movement is unavailable for the affected turn without assigning a distance."},
    {"id":"restricted_attack_choice","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"The available attack and target depend on creatures within reach."},
    {"id":"flat_armor_class_penalty","family":"defense_impairment","exposure_basis":"incoming_attack_opportunity","default_status":"candidate","reason":"Armor Class is reduced by an exact flat amount."},
    {"id":"flat_save_roll_penalty","family":"save_impairment","exposure_basis":"save_opportunity","default_status":"candidate","reason":"A specified saving throw is reduced by an exact flat amount."},
    {"id":"finite_next_save_roll_penalty","family":"save_impairment","exposure_basis":"save_opportunity","default_status":"context_required","reason":"The next qualifying save uses an exact finite penalty die and requires a downstream save opportunity."},
    {"id":"speed_multiplier","family":"mobility","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Speed is multiplied by an exact proportion rather than reduced by an invented number of feet."},
    {"id":"somatic_spell_failure","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value requires a qualifying spell with a Somatic component."},
    {"id":"damage_roll_penalty","family":"offense","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Damage rolls are reduced without changing attack accuracy; value requires an offensive-output convention."},
    {"id":"two_sided_isolation","family":"interaction_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Interaction is blocked in both directions and cannot be valued as unilateral denial."},
    {"id":"target_protection","family":"defense_enablement","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"The controlled target is also protected from outside effects or attacks."},
    {"id":"retained_action_option","family":"option_preservation","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"The target retains a specified Action or movement option that limits net control value."},
    {"id":"spellcasting_interruption","family":"action_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value requires a qualifying observable enemy spellcasting opportunity."},
    {"id":"ongoing_spell_removal","family":"state_removal","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value requires a qualifying ongoing spell state and its established consequence."},
    {"id":"hostile_transformation","family":"state_change","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on an approved replacement-form inventory and its exact statistics."},
    {"id":"attitude_change","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Behavioral value depends on encounter choices and is not inferred."},
    {"id":"size_change","family":"state_change","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Size change has value only when another established mechanic depends on size."},
    {"id":"open_ended_behavior","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Behavioral consequences depend on an encounter-specific choice that the benchmark does not invent."},
    {"id":"held_item_loss","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value depends on whether the target holds relevant items and can recover or replace them."},
    {"id":"standing_movement_cost","family":"mobility","exposure_basis":"target_turn_window","default_status":"candidate","reason":"Standing from Prone consumes half the target's Speed on its turn when standing is legal."},
    {"id":"damage_output_change","family":"offense","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Damage-output changes remain visible but outside the current Control Value scalar boundary."},
    {"id":"hearing_option_denial","family":"option_restriction","exposure_basis":"contextual_opportunity","default_status":"context_required","reason":"Value requires a hearing-dependent option or communication opportunity."}
