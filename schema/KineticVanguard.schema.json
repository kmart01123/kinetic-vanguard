{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-vanguard.invalid/KineticVanguard.schema.json",
  "title": "Kinetic Vanguard authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_version", "metadata", "vocabularies", "facets", "entities", "calculator", "navigation", "onboarding"],
  "properties": {
    "schema_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rules_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "metadata": {"$ref":"#/$defs/metadata"},
    "vocabularies": {
      "type":"object",
      "additionalProperties": {"type":"array","items":{"$ref":"#/$defs/vocabularyValue"},"minItems":1}
    },
    "facets": {"type":"array","items":{"$ref":"#/$defs/facet"},"minItems":4},
    "entities": {"type":"array","items":{"$ref":"#/$defs/entity"},"minItems":1},
    "calculator": {"$ref":"#/$defs/calculator"},
    "navigation": {"$ref":"#/$defs/navigation"},
    "onboarding": {"$ref":"#/$defs/onboarding"},
    "audits": {"type":"array","items":{"$ref":"#/$defs/audit"},"default":[]}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "metadata": {
      "type":"object","additionalProperties":false,
      "required":["title","attribution","license"],
      "properties": {
        "title":{"type":"string","minLength":1},
        "attribution":{"type":"string","minLength":1},
        "license":{"type":"string","minLength":1},
        "compatibility":{"type":"string","minLength":1},
        "release_notes":{"type":"string","minLength":1}
      }
    },
    "vocabularyValue": {
      "type":"object","additionalProperties":false,"required":["id","label","order"],
      "properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"order":{"type":"integer","minimum":0}}
    },
    "facet": {
      "type":"object","additionalProperties":false,"required":["id","label","cardinality","requiredness","applicability","order","vocabulary"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},
        "cardinality":{"enum":["single","multi"]},"requiredness":{"enum":["always","applicable"]},
        "applicability":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["all","entity_kind","rules_area"]},"values":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true}}},
        "order":{"type":"integer","minimum":0},"vocabulary":{"$ref":"#/$defs/id"}
      }
    },
    "calculatorLevelBand": {
      "type":"object","additionalProperties":false,"required":["minimum_level","maximum_level","value"],
      "properties":{
        "minimum_level":{"type":"integer","minimum":3,"maximum":20},
        "maximum_level":{"type":"integer","minimum":3,"maximum":20},
        "value":{"type":"integer","minimum":1}
      }
    },
    "calculatorTierMinimumLevel": {
      "type":"object","additionalProperties":false,"required":["tier","minimum_level"],
      "properties":{"tier":{"type":"integer","minimum":0,"maximum":2},"minimum_level":{"type":"integer","minimum":3,"maximum":20}}
    },
    "calculatorDamage": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","resolution"],"properties":{"kind":{"const":"none"},"resolution":{"enum":["always","failed_save","half_on_success"]}}},
        {"type":"object","additionalProperties":false,"required":["kind","resolution","value"],"properties":{"kind":{"const":"fixed"},"resolution":{"enum":["always","failed_save","half_on_success"]},"value":{"type":"integer","minimum":0}}},
        {"type":"object","additionalProperties":false,"required":["kind","resolution","count","sides"],"properties":{"kind":{"const":"dice"},"resolution":{"enum":["always","failed_save","half_on_success"]},"count":{"type":"integer","minimum":1},"sides":{"type":"integer","minimum":2}}},
        {"type":"object","additionalProperties":false,"required":["kind","resolution","count"],"properties":{"kind":{"const":"manifested_strike_dice"},"resolution":{"enum":["always","failed_save","half_on_success"]},"count":{"type":"integer","minimum":1}}},
        {"type":"object","additionalProperties":false,"required":["kind","resolution"],"properties":{"kind":{"const":"psionic_ability_modifier"},"resolution":{"enum":["always","failed_save","half_on_success"]},"multiplier":{"type":"integer","minimum":1}}}
      ]
    },
    "calculatorTier": {
      "type":"object","additionalProperties":false,"required":["tier","damage"],
      "properties":{
        "tier":{"type":"integer","minimum":0,"maximum":2},
        "damage":{"$ref":"#/$defs/calculatorDamage"},
        "secondary_damage":{"$ref":"#/$defs/calculatorDamage"},
        "save":{"enum":["strength","constitution","dexterity","intelligence","charisma"]}
      }
    },
    "calculatorFeature": {
      "type":"object","additionalProperties":false,"required":["entity_id","delivery","tiers"],
      "properties":{
        "entity_id":{"$ref":"#/$defs/id"},
        "delivery":{"enum":["on_hit_rider","standalone"]},
        "tiers":{"type":"array","items":{"$ref":"#/$defs/calculatorTier"},"minItems":3,"maxItems":3}
      }
    },
    "calculator": {
      "type":"object","additionalProperties":false,
      "required":["default_feature_id","default_fighter_level","default_psionic_ability_modifier","fighter_level_minimum","fighter_level_maximum","psionic_ability_modifier_minimum","psionic_ability_modifier_maximum","proficiency_bonus_bands","psi_point_bands","psionic_focus_bands","manifested_strike_die_bands","tier_minimum_levels","features"],
      "properties":{
        "default_feature_id":{"$ref":"#/$defs/id"},
        "default_fighter_level":{"type":"integer","minimum":3,"maximum":20},
        "default_psionic_ability_modifier":{"type":"integer","minimum":0,"maximum":5},
        "fighter_level_minimum":{"const":3},
        "fighter_level_maximum":{"const":20},
        "psionic_ability_modifier_minimum":{"const":0},
        "psionic_ability_modifier_maximum":{"const":5},
        "proficiency_bonus_bands":{"type":"array","items":{"$ref":"#/$defs/calculatorLevelBand"},"minItems":1},
        "psi_point_bands":{"type":"array","items":{"$ref":"#/$defs/calculatorLevelBand"},"minItems":1},
        "psionic_focus_bands":{"type":"array","items":{"$ref":"#/$defs/calculatorLevelBand"},"minItems":1},
        "manifested_strike_die_bands":{"type":"array","items":{"$ref":"#/$defs/calculatorLevelBand"},"minItems":1},
        "tier_minimum_levels":{"type":"array","items":{"$ref":"#/$defs/calculatorTierMinimumLevel"},"minItems":3,"maxItems":3},
        "features":{"type":"array","items":{"$ref":"#/$defs/calculatorFeature"},"minItems":1}
      }
    },
    "typedValue": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"integer"},"value":{"type":"integer"},"unit":{"type":"string"}}},
        {"type":"object","additionalProperties":false,"required":["kind","count","sides"],"properties":{"kind":{"const":"dice"},"count":{"type":"integer","minimum":1},"sides":{"type":"integer","minimum":2},"modifier":{"type":"integer"}}},
        {"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"reference"},"value":{"$ref":"#/$defs/id"}}}
      ]
    },
    "inline": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"text"},"text":{"type":"string","minLength":1}}},
        {"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"enum":["emphasis","strong","code"]},"text":{"type":"string","minLength":1}}},
        {"type":"object","additionalProperties":false,"required":["type","term_id","label"],"properties":{"type":{"const":"term_reference"},"term_id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1}}},
        {"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"typed_value"},"value":{"$ref":"#/$defs/typedValue"}}}
      ]
    },
    "tableRowReference": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["entity_id","reference_level"],"properties":{"entity_id":{"$ref":"#/$defs/id"},"reference_level":{"enum":["3rd","5th","7th","10th","15th","18th","20th","15th+","18th+"]}}},
        {"type":"object","additionalProperties":false,"required":["reference_group","reference_level"],"properties":{"reference_group":{"enum":["common_features","advanced_training","cryokinesis","pyrokinesis","psychokinesis","electrokinesis"]},"reference_level":{"enum":["3rd","5th","7th","10th","15th","18th","20th","15th+","18th+"]}}}
      ]
    },
    "examplePhaseBlock": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["type","inlines"],"properties":{"type":{"const":"paragraph"},"inlines":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","style","items"],"properties":{"type":{"const":"list"},"style":{"enum":["ordered","unordered"]},"items":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"minItems":1}}}
      ]
    },
    "block": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["type","inlines"],"properties":{"type":{"const":"paragraph"},"inlines":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","style","items"],"properties":{"type":{"const":"list"},"style":{"enum":["ordered","unordered"]},"items":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","kind","inlines"],"properties":{"type":{"const":"note"},"kind":{"enum":["note","warning"]},"inlines":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","headers","rows"],"properties":{"type":{"const":"table"},"headers":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"minItems":1},"rows":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1}},"minItems":1},"row_references":{"type":"array","items":{"$ref":"#/$defs/tableRowReference"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","tier","heading","body"],"properties":{"type":{"const":"tier"},"tier":{"type":"integer","minimum":0},"heading":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"body":{"type":"array","items":{"$ref":"#/$defs/block"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","tier","title","body"],"properties":{"type":{"const":"example"},"tier":{"type":"integer","minimum":0},"title":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"body":{"type":"array","items":{"$ref":"#/$defs/block"},"minItems":1}}},
        {"type":"object","additionalProperties":false,"required":["type","discipline","heading","title","setup","activation","rolls_or_saves","damage","effects","result"],"properties":{"type":{"const":"example_play_section"},"discipline":{"enum":["cryokinesis","pyrokinesis","psychokinesis","electrokinesis"]},"heading":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"title":{"type":"array","items":{"$ref":"#/$defs/inline"},"minItems":1},"setup":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1},"activation":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1},"rolls_or_saves":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1},"damage":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1},"effects":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1},"result":{"type":"array","items":{"$ref":"#/$defs/examplePhaseBlock"},"minItems":1}}}
      ]
    },
    "classifications": {
      "type":"object","additionalProperties":false,"required":["rules_area","entity_kind"],
      "properties":{"rules_area":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"uniqueItems":true},"entity_kind":{"$ref":"#/$defs/id"},"feature_role":{"$ref":"#/$defs/id"},"acquisition_mode":{"$ref":"#/$defs/id"}}
    },
    "entity": {
      "type":"object","additionalProperties":false,
      "required":["id","title","publishable","kind","content","classifications","presentation_metadata"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"short_title":{"type":"string","minLength":1},
        "publishable":{"const":true},"kind":{"$ref":"#/$defs/id"},
        "level":{"type":"integer","minimum":1,"maximum":20},"progression_section":{"enum":["foundation","reference"]},"psi_cost":{"type":"integer","minimum":0},"activation":{"$ref":"#/$defs/id"},"requires_concentration":{"type":"boolean"},"concentration_duration":{"type":"string","minLength":1},
        "content":{"type":"array","items":{"$ref":"#/$defs/block"},"minItems":1},
        "classifications":{"$ref":"#/$defs/classifications"},
        "presentation_metadata":{"type":"object","additionalProperties":false,"required":["primary_rules_area","canonical_topic_by_area"],"properties":{"primary_rules_area":{"$ref":"#/$defs/id"},"canonical_topic_by_area":{"type":"object","additionalProperties":{"$ref":"#/$defs/id"}}}},
        "related_entity_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true}
      }
    },
    "topic": {
      "type":"object","additionalProperties":false,"required":["id","title","entity_ids","order"],
      "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"entity_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"uniqueItems":true},"order":{"type":"integer","minimum":0}}
    },
    "category": {
      "type":"object","additionalProperties":false,"required":["id","label","order","default_topic_id","topics"],
      "properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"order":{"type":"integer","minimum":0},"default_topic_id":{"$ref":"#/$defs/id"},"topics":{"type":"array","items":{"$ref":"#/$defs/topic"},"minItems":1}}
    },
    "navigation": {
      "type":"object","additionalProperties":false,"required":["default_category_id","categories"],
      "properties":{"default_category_id":{"$ref":"#/$defs/id"},"categories":{"type":"array","items":{"$ref":"#/$defs/category"},"minItems":6}}
    },
    "onboardingDestination": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","section_id"],"properties":{"kind":{"const":"onboarding_section"},"section_id":{"$ref":"#/$defs/id"}}},
        {"type":"object","additionalProperties":false,"required":["kind","category_id"],"properties":{"kind":{"const":"category"},"category_id":{"$ref":"#/$defs/id"}}},
        {"type":"object","additionalProperties":false,"required":["kind","entity_id"],"properties":{"kind":{"const":"entity"},"entity_id":{"$ref":"#/$defs/id"}}}
      ]
    },
    "onboardingLink": {
      "type":"object","additionalProperties":false,"required":["id","title","destination"],
      "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"destination":{"$ref":"#/$defs/onboardingDestination"}}
    },
    "onboardingGlossaryEntry": {
      "type":"object","additionalProperties":false,"required":["id","title","definition","destination"],
      "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"definition":{"type":"string","minLength":1},"destination":{"$ref":"#/$defs/onboardingDestination"}}
    },
    "onboarding": {
      "type":"object","additionalProperties":false,
      "required":["id","title","introduction","primary_paths","disciplines","basic_turn","build_checklist","glossary","next_destinations"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},
        "title":{"type":"string","minLength":1},
        "introduction":{
          "type":"object","additionalProperties":false,"required":["summary","no_psi_note","orientation"],
          "properties":{"summary":{"type":"string","minLength":1},"no_psi_note":{"type":"string","minLength":1},"orientation":{"type":"string","minLength":1}}
        },
        "primary_paths":{"type":"array","items":{"$ref":"#/$defs/onboardingLink"},"minItems":3,"maxItems":3},
        "disciplines":{
          "type":"object","additionalProperties":false,"required":["id","title","cards"],
          "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"cards":{"type":"array","items":{"$ref":"#/$defs/onboardingLink"},"minItems":4,"maxItems":4}}
        },
        "basic_turn":{
          "type":"object","additionalProperties":false,"required":["id","title","steps","reminders","destinations"],
          "properties":{
            "id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},
            "steps":{"type":"array","items":{"type":"string","minLength":1},"minItems":4,"maxItems":4},
            "reminders":{"type":"array","items":{"type":"string","minLength":1},"minItems":3,"maxItems":3},
            "destinations":{"type":"array","items":{"$ref":"#/$defs/onboardingLink"},"minItems":2,"maxItems":2}
          }
        },
        "build_checklist":{
          "type":"object","additionalProperties":false,"required":["id","title","items"],
          "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"items":{"type":"array","items":{"$ref":"#/$defs/onboardingLink"},"minItems":6,"maxItems":6}}
        },
        "glossary":{
          "type":"object","additionalProperties":false,"required":["id","title","entries"],
          "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"entries":{"type":"array","items":{"$ref":"#/$defs/onboardingGlossaryEntry"},"minItems":5,"maxItems":5}}
        },
        "next_destinations":{
          "type":"object","additionalProperties":false,"required":["id","title","items"],
          "properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"items":{"type":"array","items":{"$ref":"#/$defs/onboardingLink"},"minItems":7,"maxItems":7}}
        }
      }
    },
    "audit": {
      "type":"object","additionalProperties":false,"required":["id","assertion","subject_ids"],
      "properties":{"id":{"$ref":"#/$defs/id"},"assertion":{"type":"string","minLength":1},"subject_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1}}
    }
  }
}
