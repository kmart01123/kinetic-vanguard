{
  "name": "kinetic-vanguard-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-first deterministic static rules reference for Kinetic Vanguard",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "validate": "tsx src/cli.ts validate",
    "build": "tsx src/cli.ts build --profile prototype",
    "build:release": "tsx src/cli.ts build --profile release",
    "promote": "tsx src/promote.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:layout": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 tsx --test tests/layout.browser.ts",
    "test:determinism": "tsx src/determinism.ts",
    "control:engine:validate": "python3 -m harness.control_engine --validate-only",
    "control:engine:fixtures": "python3 -m unittest harness.tests.test_control_engine_fixtures",
    "harness:validate": "python3 -m harness.damage_harness --output-dir /tmp/kv-harness-validation --validate-only && python3 -m harness.authority --projection-version 2.1.0 --require-benchmark-ready && python3 -m harness.control_targets && python3 -m harness.control_engine --validate-only",
    "test:harness": "python3 -m unittest discover -s harness/tests -p 'test_*.py'",
    "harness:damage": "python3 -m harness.damage_harness",
    "readme:damage": "python3 -m harness.readme_damage --write --workers 4",
    "readme:damage:check": "python3 -m harness.readme_damage --check --workers 4"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "24.1.0",
    "jsdom": "26.1.0",
    "playwright": "1.55.1",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
