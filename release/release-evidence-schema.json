{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic-vanguard.invalid/release-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["build_manifest_sha256", "evidence", "approver", "decision", "date"],
  "properties": {
    "build_manifest_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "evidence": {"type":"array","items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},
    "approver": {"type":"string","minLength":1},
    "decision": {"enum":["approved","rejected"]},
    "date": {"type":"string","format":"date"}
  }
}
