{
	"name": "Kinetic Vanguard",

	"image": "mcr.microsoft.com/devcontainers/base:resolute",

	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.13",
			"installTools": false,
			"installJupyterlab": false
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24.18.1",
			"npmVersion": "11.16.0"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "2.97.0"
		}
	},

	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"CODEX_HOME": "/home/vscode/.codex",
		"GH_CONFIG_DIR": "/home/vscode/.config/gh"
	},

	"mounts": [
		"source=kinetic-vanguard-codex,target=/home/vscode/.codex,type=volume",
		"source=kinetic-vanguard-gh,target=/home/vscode/.config/gh,type=volume",
		"source=kinetic-vanguard-claude,target=/home/vscode/.claude,type=volume",
		"source=kinetic-vanguard-grok,target=/home/vscode/.grok,type=volume",
		"source=kinetic-vanguard-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"openai.chatgpt",
				"redhat.vscode-yaml",
				"ms-vscode.live-server",
				"ms-playwright.playwright"
			],
			"settings": {
				"livePreview.portNumber": 3000,
				"livePreview.autoRefreshPreview": "On Changes to Saved Files",
				"livePreview.openPreviewTarget": "External Browser"
			}
		}
	},

	"forwardPorts": [
		3000
	],

	"portsAttributes": {
		"3000": {
			"label": "Kinetic Vanguard Live Preview",
			"onAutoForward": "openBrowser"
		}
	},

	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"remoteUser": "vscode"
}
